# Real keys live here. This file is gitignored — never commit it.

# Public URL of the site. Used to build Stripe success/cancel redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ----------------------------------------------------------------
# Dashboard -> Developers -> API keys
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or Dashboard -> Developers -> Webhooks in prod.
STRIPE_WEBHOOK_SECRET=

# --- Twilio (drop alerts) --------------------------------------------------
# Optional. Leave blank and the SMS features stay switched off cleanly —
# /admin/drops explains what's missing and members are never shown the opt-in.
#
# Console -> Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Messaging -> Services. Not a bare phone number: the Messaging Service is what
# carries the 10DLC campaign registration and handles STOP at the carrier.
TWILIO_MESSAGING_SERVICE_SID=
# Verify -> Services. Sends and checks the one-time codes.
TWILIO_VERIFY_SERVICE_SID=